# Backend Smart FnB — prefix api/v1. Sao chép file này thành .env.local và chỉnh nếu cần.
VITE_API_BASE_URL=http://localhost:3100/api/v1

# Bật phân hệ Waiter/Kitchen trên web. Mặc định tắt vì hai vai trò này đã
# chuyển sang ứng dụng tablet; code vẫn giữ nguyên, chỉ ẩn lối vào.
VITE_ENABLE_STAFF_APPS=false
