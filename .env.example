# Backend Smart FnB — prefix api/v1. Sao chép file này thành .env.local và chỉnh nếu cần.
VITE_API_BASE_URL=http://localhost:3100/api/v1

# Cờ theo TỪNG module của lớp API (src/api): real = gọi backend, mock = dữ liệu giả lập trong trình duyệt.
# Bỏ trống = dùng mặc định theo docs/BAN-GIAO.md (bảng cờ module) và src/api/flags.ts. Bảng cờ in ra console khi chạy `vite dev`.
# Module: AUTH BRANCH REPORT PLAN MENU OPTIONS BRANCH_OPTIONS BRANDING ACCOUNT STATIONS ORDER MANAGER_REPORT AI ADMIN PAYOS
# Mặc định real: auth branch report plan menu options branch_options account(một phần) stations admin. Mock: ai. Mặc định real thêm branding (6.4), payos (6.5) order (7.1, tra cứu đơn của Manager; VITE_API_ORDER=mock để dùng dữ liệu giả) và manager_report (7.3, báo cáo chi nhánh của Manager; VITE_API_MANAGER_REPORT=mock).
# VITE_API_BRANCH=mock
# VITE_API_MENU=real
# VITE_API_OPTIONS=real          # tuỳ chọn món của Owner (OW-03, /restaurant-chains/{id}/menu/option-groups); mock = dữ liệu giả lập, lưu qua F5
# VITE_API_BRANDING=real         # nhận diện thương hiệu (OW-07, /restaurant-chains/{id}/branding, tải logo multipart); mock = dữ liệu giả lập, logo là data URL
# VITE_API_BRANCH_OPTIONS=real   # tuỳ chọn theo chi nhánh của Manager (GET/PATCH /manager/menu-options); mock = dữ liệu giả lập, lưu qua F5
